<UserControl x:Class="CryptoPeek.Views.CoinsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CryptoPeek.Views"
             xmlns:converters="clr-namespace:CryptoPeek.Converters"
             xmlns:controls="clr-namespace:CryptoPeek.Controls"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.08*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:SearchBox DataContext="{Binding}"
                            Margin="10"
                            HorizontalAlignment="Left"
                            IsFocusedSearchBox="{Binding IsSearchFocused, Mode=OneWayToSource}"
                            SearchText="{Binding SearchText,
                              Mode=OneWayToSource}"
                            ClearCommand="{Binding ClearSearchCommand}"/>

        <ListView Grid.Row="1" 
                  ItemsSource="{Binding Coins}"
                  Margin="0">

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <prism:InvokeCommandAction Command="{Binding OpenCoinDetailsCommand}"
                                               CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListView}}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <ListView.Resources>
                
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>

                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F5F5F5" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
            </ListView.Resources>
            
            <ListView.View>
                <GridView>

                    <GridViewColumn Width="32">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                
                                <Image Source="{Binding Image}"
                                       Width="18"
                                       Height="18" />
                                
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Name"
                                    Width="150"
                                    DisplayMemberBinding="{Binding Name}" />

                    <GridViewColumn Header="Symbol"
                                    Width="80"
                                    DisplayMemberBinding="{Binding Symbol}" />

                    <GridViewColumn Header="Price (USD)"
                                    Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                
                                <TextBlock Text="{Binding CurrentPrice, Converter={StaticResource coinPriceConverter}}" />
                                
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="24h %"
                                    Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock Text="{Binding PriceChangePercentage24h, Converter={StaticResource priceChangePercent24Converter}}"
                                           Foreground="{Binding PriceChangePercentage24h, Converter={StaticResource priceChangePercent24ToBrushConverter}}"/>
                                
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Market Cap"
                                    Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock Text="{Binding MarketCap, Converter={StaticResource coinPriceConverter}}" />
                                
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Volume (24h)"
                Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock Text="{Binding TotalVolume, Converter={StaticResource coinPriceConverter}}" />

                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>
        
    </Grid>
</UserControl>
