<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#121212"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#0D47A1"/>

    <SolidColorBrush x:Key="PrimarTextyBrush"    Color="#111827"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"  Color="#4B5563"/>
    <SolidColorBrush x:Key="PlaceholderBrush"    Color="#9CA3AF"/>

    <SolidColorBrush x:Key="PositiveChangeBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="NegativeChangeBrush" Color="#F44336"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#111827"/>
    <SolidColorBrush x:Key="ControlBorderBrush"     Color="#D1D5DB"/>

    <SolidColorBrush x:Key="ListItemBackgroundBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ListItemHoverBrush"              Color="#F3F4F6"/>
    <SolidColorBrush x:Key="ListItemSelectedBrush"           Color="#DBEAFE"/>
    <SolidColorBrush x:Key="ListItemSelectedForegroundBrush" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="SelectionBrush"                  Color="#DBEAFE"/>
    <SolidColorBrush x:Key="SelectionForegroundBrush"        Color="#1E3A8A"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#4F46E5"/>

</ResourceDictionary>