<UserControl x:Class="CryptoPeek.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CryptoPeek.Controls"
             mc:Ignorable="d">

    <Grid>

        <Border x:Name="MainBorder" 
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Height="25"
                MaxWidth="210"
                MinWidth="170">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/Resources/Images/ic_search.png"
                       Width="16"
                       Height="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.8" />

                <TextBox Grid.Column="1"
                         x:Name="SearchTextBox"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         Padding="0,0,16,0"
                         GotFocus="SearchTextBox_GotFocus"
                         Text="{Binding SearchText,
                                RelativeSource={RelativeSource AncestorType=local:SearchBox},
                                Mode=OneWayToSource,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Placeholder -->
                <TextBlock x:Name="PlaceholderText" 
                           Grid.Column="1"
                           Text="Search.."
                           FontSize="14"
                           Foreground="#9E9E9E"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />

                <Button x:Name="ClearButton" 
                        Grid.Column="2"
                        Content="&#x274E;"
                        FontSize="12"
                        TextBlock.TextAlignment="Justify"
                        Width="16"
                        Height="16"
                        Padding="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Gray"
                        ToolTip="Clear"
                        Command="{Binding ClearCommand, RelativeSource={RelativeSource AncestorType=local:SearchBox}}"
                        Click="ClearButton_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    
                </Button>

            </Grid>
            
        </Border>
        
    </Grid>

</UserControl>
