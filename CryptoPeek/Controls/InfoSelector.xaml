<UserControl x:Class="CryptoPeek.Controls.InfoSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CryptoPeek.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>

        <DropShadowEffect x:Key="ShadowEffect"
                          Color="Black"
                          Direction="270"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Opacity="0.2" />

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#CCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="False" />
        </Style>

        <Style x:Key="ValueCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Effect" Value="{StaticResource ShadowEffect}" />
        </Style>
        
    </UserControl.Resources>
    
    <Border CornerRadius="10"
            BorderBrush="#DDD"
            BorderThickness="1"
            Padding="12"
            Background="White"
            Effect="{StaticResource ShadowEffect}">

        <StackPanel>

            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#444"
                       Margin="0,0,0,8"
                       HorizontalAlignment="Center"/>

            <ComboBox ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                      Margin="0,0,0,10"
                      SelectedIndex="0"
                      TextBlock.FontWeight="Medium"/>

            <Border Style="{StaticResource ValueCardStyle}">

                <TextBlock Text="{Binding SelectedValue, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource decimalToStringConverter}}"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="#111"
                           HorizontalAlignment="Center" />
                
            </Border>

        </StackPanel>
            
    </Border>
    
</UserControl>
